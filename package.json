{
  "name": "@shakaran/symfony-agent-mcp",
  "version": "1.0.3",
  "mcpName": "io.github.shakaran/symfony-agent-mcp",
  "description": "Model Context Protocol server for Symfony applications — read-only introspection of routes, services, entities, controllers, database schema, migrations, composer packages, and logs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "symfony-agent-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "build:vex": "node scripts/generate-vex.mjs",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:md": "markdownlint-cli2 \"*.md\"",
    "headers": "node scripts/add-license-headers.mjs",
    "headers:check": "node scripts/add-license-headers.mjs --check",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "symfony",
    "symfony6",
    "symfony7",
    "symfony8",
    "doctrine",
    "php",
    "introspection",
    "agent",
    "ai-assistant",
    "claude",
    "cursor",
    "llm",
    "developer-tools",
    "api-inspector"
  ],
  "author": "Ángel Guzmán Maeso <angel@guzmanmaeso.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "markdownlint-cli2": "^0.23.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.5.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/shakaran/symfony-agent-mcp"
  },
  "homepage": "https://github.com/shakaran/symfony-agent-mcp#readme",
  "bugs": {
    "url": "https://github.com/shakaran/symfony-agent-mcp/issues"
  }
}
