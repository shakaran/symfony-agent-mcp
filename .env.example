# symfony-agent-mcp — Environment Variables Reference
#
# Copy this file to .env and fill in the values for your deployment.
# All variables are optional unless marked REQUIRED.
#
# Security-critical variables are marked with [SECURITY].
# Variables that are DISABLED by default and must be explicitly enabled
# are marked accordingly.
#
# Generate random secrets with:   openssl rand -base64 32


# ─── Transport ────────────────────────────────────────────────────────────────

# Port for the HTTP/SSE transport. Leave unset to use stdio only (default).
# Example: 3000
SYMFONY_MCP_HTTP_PORT=

# Network interface to bind the HTTP server to.
# Default: 127.0.0.1 (loopback only). Set to 0.0.0.0 only in trusted networks.
SYMFONY_MCP_HTTP_HOST=127.0.0.1

# Set to "false" to disable stdio transport when the HTTP server is running.
# Default: stdio is always active alongside HTTP.
SYMFONY_MCP_STDIO=true

# Maximum size of a single HTTP request body in bytes.
# Default: 1048576 (1 MB). Raise only if you need large payloads.
SYMFONY_MCP_MAX_PAYLOAD_BYTES=1048576

# Allowed client IP addresses for the HTTP transport (comma-separated CIDR or IPs).
# Leave empty to allow all — restrict in production to known AI client IPs.
# Example: 192.168.1.0/24,10.0.0.5
SYMFONY_MCP_ALLOWED_IPS=

# CORS origin allowed by the HTTP server. Default: * (all origins).
# Set to your specific AI assistant origin in production.
SYMFONY_MCP_CORS_ORIGIN=*


# ─── TLS (HTTP transport) ─────────────────────────────────────────────────────

# [SECURITY] Path to the TLS certificate file (.pem or .crt).
# Required to enable HTTPS for the HTTP transport.
SYMFONY_MCP_TLS_CERT=

# [SECURITY] Path to the TLS private key file (.pem or .key).
# Required to enable HTTPS for the HTTP transport.
SYMFONY_MCP_TLS_KEY=

# [SECURITY] Path to a CA certificate bundle for mutual TLS (mTLS) client verification.
# Optional — only needed if clients present certificates for authentication.
SYMFONY_MCP_TLS_CA=


# ─── Session Tokens ───────────────────────────────────────────────────────────

# [SECURITY] REQUIRED in production. The session token the client must provide.
# If SYMFONY_MCP_SESSION_SECRET is set, this acts as a TOTP-style rolling token.
# Generate with: openssl rand -hex 32
SYMFONY_MCP_SESSION_TOKEN=

# [SECURITY] Secret used to derive time-based rolling session tokens (TOTP-style).
# When set, tokens are valid for SYMFONY_MCP_SESSION_WINDOW seconds, then rotate.
# Generate with: openssl rand -base64 32
SYMFONY_MCP_SESSION_SECRET=

# Duration (seconds) for which a derived session token is valid.
# Default: 300 (5 minutes). Shorter = more secure; longer = less friction.
SYMFONY_MCP_SESSION_WINDOW=300

# Set to "true" to require session tokens even in stdio mode.
# Default: false (stdio is trusted — it runs as the local user).
SYMFONY_MCP_SESSION_STRICT=false


# ─── Request Signing ──────────────────────────────────────────────────────────

# [SECURITY] HMAC-SHA256 secret for request signing.
# When set, every tool call must carry a valid _signature field.
# Generate with: openssl rand -base64 32
SYMFONY_MCP_SIGNING_SECRET=

# Replay-attack prevention: how long a nonce remains valid (milliseconds).
# Default: 30000 (30 seconds). Nonces seen within this window are rejected.
SYMFONY_MCP_REPLAY_WINDOW_MS=30000

# Set to "true" to reject requests that lack a signature even when
# SYMFONY_MCP_SIGNING_SECRET is not configured. Useful for hardened deployments.
SYMFONY_MCP_SIGN_STRICT=false


# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Maximum number of requests per tool per time window.
# Default: 60. Set to 0 to disable rate limiting entirely.
SYMFONY_MCP_RATE_LIMIT=60

# Duration of the rate-limit sliding window in milliseconds.
# Default: 60000 (1 minute).
SYMFONY_MCP_RATE_WINDOW_MS=60000

# Maximum burst requests allowed within any 1-second window.
# Default: 10. This prevents sudden spikes even within the larger window.
SYMFONY_MCP_RATE_BURST=10


# ─── App Path Security ────────────────────────────────────────────────────────

# [SECURITY] Colon-separated list of filesystem paths the server is allowed
# to inspect. Requests for paths outside this list are rejected.
# Leave empty to allow any path (not recommended in production).
# Example: /var/www/my-app:/var/www/other-app
SYMFONY_MCP_ALLOWED_PATHS=

# Set to "true" to require that the app_path points to a Symfony project
# (checks for vendor/autoload.php). Rejects non-Symfony directories.
SYMFONY_MCP_REQUIRE_SYMFONY=false


# ─── Tool Access Control ──────────────────────────────────────────────────────

# Comma-separated allowlist of tools the client may call.
# When set, only these tools are available — all others are blocked.
# Takes lower precedence than SYMFONY_MCP_BLOCKED_TOOLS.
# Example: list_routes,list_services,get_app_environment
SYMFONY_MCP_ALLOWED_TOOLS=

# Comma-separated denylist of tools that are always blocked.
# Takes precedence over SYMFONY_MCP_ALLOWED_TOOLS.
# Example: get_database_config,list_environment_variables,get_security_config
SYMFONY_MCP_BLOCKED_TOOLS=


# ─── Concurrency & Timeouts ───────────────────────────────────────────────────

# Maximum number of tool calls that can execute simultaneously.
# Default: 10. Set to 0 for unlimited (not recommended in production).
SYMFONY_MCP_MAX_CONCURRENT=10

# Maximum number of requests waiting in the concurrency queue.
# Default: 20. Requests beyond this limit are rejected immediately.
SYMFONY_MCP_CONCURRENT_QUEUE=20

# Maximum time (milliseconds) a single tool call is allowed to run.
# Default: 30000 (30 seconds). Timed-out calls return an error to the client.
SYMFONY_MCP_TOOL_TIMEOUT_MS=30000

# Maximum size (bytes) of a tool's output text.
# Default: 1048576 (1 MB). Output exceeding this is truncated before DLP scanning.
SYMFONY_MCP_MAX_OUTPUT_BYTES=1048576

# Maximum requests per IP per 60-second window for the HTTP transport (R).
# Default: 120. Set to 0 to disable per-IP rate limiting.
# Applies in addition to the per-tool rate limit (SYMFONY_MCP_RATE_LIMIT).
SYMFONY_MCP_HTTP_RATE_LIMIT=120


# ─── Audit Logging ────────────────────────────────────────────────────────────

# Set to "false" to disable file-based audit logging.
# Default: true (audit log is written to ~/.symfony-agent-mcp/audit.log).
SYMFONY_MCP_AUDIT=true

# Custom absolute path for the audit log file.
# Default: ~/.symfony-agent-mcp/audit.log
SYMFONY_MCP_AUDIT_LOG=

# Audit log format. Options: "jsonl" (default) or "cef" (SIEM-compatible).
# CEF (Common Event Format) integrates with Splunk, ArcSight, QRadar, etc.
SYMFONY_MCP_AUDIT_FORMAT=jsonl

# [SECURITY] AES-256-GCM encryption key for the audit log (32-byte base64 string).
# When set, every log entry is encrypted at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYMFONY_MCP_AUDIT_KEY=

# [SECURITY] Previous audit encryption key (for zero-downtime key rotation).
# Set this to the OLD value of SYMFONY_MCP_AUDIT_KEY when rotating keys.
# Entries written with the old key can still be decrypted while this is set.
# Clear this variable after re-encrypting old log entries with reencryptAuditLog().
SYMFONY_MCP_AUDIT_KEY_PREV=

# ISO 8601 timestamp when SYMFONY_MCP_AUDIT_KEY was created.
# Used to track key age and warn when the key approaches its TTL.
# Example: 2026-06-07T12:00:00Z
SYMFONY_MCP_AUDIT_KEY_CREATED_AT=

# Maximum age (days) of the audit encryption key before rotation is required.
# Default: 90 days. The startup audit warns at HIGH when expired, MEDIUM when within 7 days.
SYMFONY_MCP_AUDIT_KEY_TTL_DAYS=90

# Maximum size of the audit log before rotation (megabytes).
# Default: 50 MB. When exceeded, the log is rotated (renamed to .1, .2, …).
SYMFONY_MCP_AUDIT_MAX_SIZE_MB=50

# Maximum number of rotated audit log files to keep.
# Default: 5. Older files are deleted automatically when the limit is reached.
SYMFONY_MCP_AUDIT_MAX_FILES=5


# ─── DLP (Data Loss Prevention) ───────────────────────────────────────────────

# Set to "false" to disable DLP structural redaction in tool outputs.
# Default: enabled. Disabling is strongly discouraged in production.
# [SECURITY] DLP is the last line of defence against credential leaks.
SYMFONY_MCP_DLP=true

# Set to "true" to replace detected secrets with a truncated hash instead of
# the generic [REDACTED:TYPE] placeholder. Useful for correlation without exposure.
SYMFONY_MCP_DLP_HASH=false

# Maximum wall-clock time (milliseconds) the DLP scanner is allowed to run
# on a single text before aborting. Prevents ReDoS on crafted inputs (T).
# Default: 500 ms. The output size cap (SYMFONY_MCP_MAX_OUTPUT_BYTES) further
# bounds the worst-case input size before DLP runs.
SYMFONY_MCP_DLP_TIMEOUT_MS=500

# ─── Prompt Injection Detection ───────────────────────────────────────────────

# Set to "false" to disable prompt injection detection in tool outputs.
# Default: enabled. Detects patterns like "Ignore all previous instructions"
# that a malicious Symfony app could embed to manipulate the AI assistant (Q).
SYMFONY_MCP_PROMPT_INJECTION=true


# ─── Anomaly Detection ────────────────────────────────────────────────────────

# Set to "false" to disable anomaly detection entirely.
# Default: enabled. Anomaly detection blocks path traversal, scanning, and spikes.
SYMFONY_MCP_ANOMALY=true

# Set to "true" to block all anomalies (including MEDIUM-severity ones).
# Default: false — only HIGH and CRITICAL anomalies are blocked automatically.
SYMFONY_MCP_ANOMALY_STRICT=false

# Sliding window for anomaly event aggregation (milliseconds).
# Default: 60000 (1 minute).
SYMFONY_MCP_ANOMALY_WINDOW_MS=60000


# ─── Anomaly Notifications ────────────────────────────────────────────────────

# Slack incoming webhook URL for anomaly alerts.
# Leave empty to disable Slack notifications.
# Example: https://hooks.slack.com/services/T.../B.../...
SYMFONY_MCP_SLACK_WEBHOOK=

# PagerDuty Events API v2 routing key for critical anomaly escalation.
# Leave empty to disable PagerDuty integration.
SYMFONY_MCP_PAGERDUTY_KEY=

# Generic webhook URL for anomaly notifications (POST with JSON payload).
# Leave empty to disable generic webhook notifications.
SYMFONY_MCP_WEBHOOK_URL=

# Minimum anomaly severity level that triggers notifications.
# Options: LOW, MEDIUM, HIGH, CRITICAL. Default: HIGH.
SYMFONY_MCP_NOTIFY_MIN_SEVERITY=HIGH


# ─── Privacy Mode ─────────────────────────────────────────────────────────────

# Data minimization level applied to all tool outputs.
# Options:
#   standard  — default; minor sanitization only
#   strict    — redacts personal data patterns (emails, IPs, phone numbers)
#   paranoid  — maximum redaction; annotates schema tools with PII warnings
SYMFONY_MCP_PRIVACY=standard

# Comma-separated list of tools that always use paranoid privacy mode,
# regardless of the SYMFONY_MCP_PRIVACY setting.
# Example: get_database_config,list_environment_variables
SYMFONY_MCP_PRIVACY_TOOLS=


# ─── Input Validation ─────────────────────────────────────────────────────────

# Set to "false" to disable schema-based input validation for tool arguments.
# Default: enabled. Validation rejects malformed or oversized parameters early.
SYMFONY_MCP_INPUT_VALIDATION=true


# ─── Metrics ──────────────────────────────────────────────────────────────────

# Set to "false" to disable in-memory security metrics collection.
# Default: enabled. Metrics track tool call counts, DLP hits, rate limit blocks, etc.
SYMFONY_MCP_METRICS=true


# ─── Startup Audit ────────────────────────────────────────────────────────────

# Set to "false" to suppress the security audit printed on startup.
# Default: enabled. The audit warns about dangerous configurations.
SYMFONY_MCP_STARTUP_AUDIT=true


# ─── Vault / Secrets Management ───────────────────────────────────────────────

# HashiCorp Vault server address.
# Example: https://vault.example.com:8200
SYMFONY_MCP_VAULT_ADDR=

# Vault access token for secret retrieval.
# Prefer AppRole authentication (SYMFONY_MCP_VAULT_ROLE_ID / SECRET_ID) over tokens.
VAULT_TOKEN=

# Vault AppRole role ID (used instead of a static token for AppRole auth).
SYMFONY_MCP_VAULT_ROLE_ID=

# Vault AppRole secret ID (paired with SYMFONY_MCP_VAULT_ROLE_ID).
SYMFONY_MCP_VAULT_SECRET_ID=

# [SECURITY] Path to a CA certificate bundle (PEM) for Vault TLS verification.
# Required when Vault uses a private CA. Vault requests are always TLS-verified.
SYMFONY_MCP_VAULT_CA_BUNDLE=

# How long (milliseconds) to cache secrets fetched from Vault before re-fetching.
# Default: 60000 (1 minute). Lower = fresher secrets; higher = fewer Vault calls.
# Send SIGUSR2 to the process to flush the cache immediately (zero-downtime rotation).
SYMFONY_MCP_SECRET_TTL_MS=60000


# ─── Debug ────────────────────────────────────────────────────────────────────

# Set to "true" to echo every audit log entry to stderr in plaintext.
# Never enable in production — this bypasses encryption and privacy mode.
SYMFONY_MCP_DEBUG=false

# Runtime environment hint used by some internal checks.
# Options: development, test, production. Default: production.
NODE_ENV=production
